# More practice with Dictionary{}
login_info = {
  "Username": "John"
  "Password": "John12345"
  "Pin": 123456
}
print(login_info)


#get() practices
result = login_info.get("Username")
print(result)

#keys() practice
print(login_info.keys())

#values() practice
print(login_info.values())

#items() practice
print(login_info.items())

#add keys
login_info["Position'] = "IT"
print(login_info)

#Modifies Keys
login_info["Username"] = "John.Smith"
print(login_info)
